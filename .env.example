# Kerberos (QE-INFRA)
KERBEROS_REALM=QE-INFRA-AD.CLOUDERA.COM
KERBEROS_PRINCIPAL=systest@QE-INFRA-AD.CLOUDERA.COM
# keytab 이 짧은 principal 이면: kinit -kt /cdep/keytabs/systest.keytab systest
KERBEROS_KEYTAB=/cdep/keytabs/systest.keytab
SPARK_YARN_PRINCIPAL=systest@QE-INFRA-AD.CLOUDERA.COM
SPARK_YARN_KEYTAB=/cdep/keytabs/systest.keytab

# Ozone (Lab 시작 전 volume·bucket·warehouse — docs/04-ozone-storage.md)
OZONE_SERVICE_ID=ozone1784520717
OZONE_VOLUME=vol1
OZONE_BUCKET=bucket1
WAREHOUSE_OFS=ofs://ozone1784520717/vol1/bucket1/warehouse

# Hive Metastore (Thrift 9083 — HA: 쉼표로 여러 URI)
HMS_URI=thrift://ccycloud-1.jshin.root.comops.site:9083,thrift://ccycloud-3.jshin.root.comops.site:9083

# HiveServer2 / Beeline (CM hiveserver2_load_balancer)
HIVESERVER2_LOAD_BALANCER=ccycloud-1.jshin.root.comops.site:10015
# JDBC URL의 host 와 principal 의 HS2 호스트 부분이 일치해야 함 (hive/<hostname>@REALM)
HIVE_SERVER2_PRINCIPAL=hive/ccycloud-1.jshin.root.comops.site@QE-INFRA-AD.CLOUDERA.COM
HIVE_SERVER2_JDBC_DATABASE=default
HIVE_SERVER2_SSL=true
HIVE_SSL_TRUSTSTORE=/var/lib/cloudera-scm-agent/agent-cert/cm-auto-global_truststore.jks
HIVE_SSL_TRUSTSTORE_PASSWORD=changeit

# 한 줄 JDBC (설정 시 run_hive_sql.sh 가 이 값을 우선 사용)
HIVE_SERVER2_JDBC=jdbc:hive2://ccycloud-1.jshin.root.comops.site:10015/default;principal=hive/ccycloud-1.jshin.root.comops.site@QE-INFRA-AD.CLOUDERA.COM;ssl=true;sslTrustStore=/var/lib/cloudera-scm-agent/agent-cert/cm-auto-global_truststore.jks;trustStorePassword=changeit

# Impala (impala-shell — CM impalad coordinator, SSL 포트는 보통 25003)
IMPALA_DAEMON=ccycloud-5.jshin.root.comops.site:25003
IMPALA_PROTOCOL=beeswax
IMPALA_SSL=true
IMPALA_CA_CERT=/var/lib/cloudera-scm-agent/agent-cert/cm-auto-global_cacerts.pem
IMPALA_DEFAULT_DATABASE=default

# Lab
LAB_DATABASE=iceberg_lab
ICEBERG_CATALOG=hive_prod

# Spark 3 — CDH edge: spark-sql 없음 → PySpark runner (기본)
# SPARK_CONF_DIR=/etc/spark3/conf.cloudera.SPARK3_ON_YARN-1
SPARK_MASTER=yarn

# HDFS HA (Spark on YARN staging — Standby NN WARN 방지)
HADOOP_CONF_DIR=/etc/hadoop/conf
# CM core-site 의 nameservice URI (예: hdfs://jshincluster). 비우면 클러스터 conf 만 사용.
# HDFS_DEFAULT_FS=hdfs://YOUR_NAMESERVICE
# SPARK_YARN_STAGING_DIR=hdfs://YOUR_NAMESERVICE/user/spark/.sparkStaging
