# Kerberos (QE-INFRA)
KERBEROS_REALM=QE-INFRA-AD.CLOUDERA.COM
KERBEROS_PRINCIPAL=systest@QE-INFRA-AD.CLOUDERA.COM
# keytab 이 짧은 principal 이면: kinit -kt /cdep/keytabs/systest.keytab systest
KERBEROS_KEYTAB=/cdep/keytabs/systest.keytab
SPARK_YARN_PRINCIPAL=systest@QE-INFRA-AD.CLOUDERA.COM
SPARK_YARN_KEYTAB=/cdep/keytabs/systest.keytab

# Ozone (Lab 시작 전 volume·bucket·warehouse — docs/04-ozone-storage.md)
OZONE_SERVICE_ID=ozone1784520717
OZONE_VOLUME=vol1
OZONE_BUCKET=bucket1
WAREHOUSE_OFS=ofs://ozone1784520717/vol1/bucket1/warehouse

# Hive Metastore (Thrift 9083 — HA: 쉼표로 여러 URI)
HMS_URI=thrift://ccycloud-1.jshin.root.comops.site:9083,thrift://ccycloud-3.jshin.root.comops.site:9083

# CM JDBC(ZK) 기본. HAProxy :10015 직접 접속만: HIVE_SERVER2_CONNECT=lb
HIVE_SERVER2_CONNECT=zk
HIVE_ZK_QUORUM=ccycloud-1.jshin.root.comops.site:2181,ccycloud-2.jshin.root.comops.site:2181,ccycloud-3.jshin.root.comops.site:2181
HIVE_ZK_NAMESPACE=hiveserver2
HIVE_SERVER2_PRINCIPAL=hive/ccycloud-1.jshin.root.comops.site@QE-INFRA-AD.CLOUDERA.COM
HIVE_SERVER2_JDBC_DATABASE=default
HIVE_SERVER2_JDBC_RETRIES=5
HIVE_KEYSTORE_TYPE=jks
HIVE_ZK_KEYSTORE_TYPE=jks
HIVE_ZK_TRUSTSTORE_TYPE=jks
# auth=KERBEROS 자동 삽입 끔 (CM/beeline 대화형 JDBC 와 동일)
# HIVE_SERVER2_ENSURE_KERBEROS_AUTH=false
HIVE_SERVER2_SSL=true
HIVE_SSL_TRUSTSTORE=/var/lib/cloudera-scm-agent/agent-cert/cm-auto-global_truststore.jks
HIVE_SSL_TRUSTSTORE_TYPE=jks
HIVE_SSL_TRUSTSTORE_PASSWORD=Prlcflcy2ZOMhtUqb0GFyd6FXKSTZfMpSU4n7kXtMaG
# CM transport.mode=binary 이면 HTTP 자동 probe 끔. http 클러스터만: HIVE_SERVER2_TRY_HTTP_PROBE=true
# HIVE_SERVER2_TRY_HTTP_PROBE=false
# CM UI placeholder 대응 (HIVE_SERVER2_JDBC 에 {{CMF_CONF_DIR}} 쓸 때)
# CMF_CONF_DIR=/var/lib/cloudera-scm-agent/agent-cert

# CM/beeline 에서 동작 확인한 한 줄 JDBC (우선). git pull 후 .env 에 반영
HIVE_SERVER2_JDBC=jdbc:hive2://ccycloud-1.jshin.root.comops.site:2181,ccycloud-2.jshin.root.comops.site:2181,ccycloud-3.jshin.root.comops.site:2181/default;keyStoreType=jks;principal=hive/ccycloud-1.jshin.root.comops.site@QE-INFRA-AD.CLOUDERA.COM;retries=5;serviceDiscoveryMode=zooKeeper;ssl=true;sslTrustStore=/var/lib/cloudera-scm-agent/agent-cert/cm-auto-global_truststore.jks;trustStorePassword=Prlcflcy2ZOMhtUqb0GFyd6FXKSTZfMpSU4n7kXtMaG;trustStoreType=jks;zooKeeperNamespace=hiveserver2;zookeeperKeyStoreType=jks;zookeeperTrustStoreType=jks

# 직접 HAProxy LB (HIVE_SERVER2_CONNECT=lb 일 때)
# HIVESERVER2_LOAD_BALANCER=ccycloud-1.jshin.root.comops.site:10015
# HIVE_SERVER2_JDBC_DATABASE=default
# principal 은 CM hive/_HOST@REALM 권장 (FQDN principal → Broken pipe 가능)
# HIVE_SERVER2_LB_PRINCIPAL=hive/_HOST@QE-INFRA-AD.CLOUDERA.COM

# Impala (impala-shell — CM impalad coordinator, SSL 포트는 보통 25003)
IMPALA_DAEMON=ccycloud-5.jshin.root.comops.site:25003
IMPALA_PROTOCOL=beeswax
IMPALA_SSL=true
IMPALA_CA_CERT=/var/lib/cloudera-scm-agent/agent-cert/cm-auto-global_cacerts.pem
IMPALA_DEFAULT_DATABASE=default

# Lab
LAB_DATABASE=iceberg_lab
ICEBERG_CATALOG=hive_prod

# Spark 3 — CDH edge: spark-sql 없음 → PySpark runner (기본)
# SPARK_CONF_DIR=/etc/spark3/conf.cloudera.SPARK3_ON_YARN-1
SPARK_MASTER=yarn

# HDFS HA (Spark on YARN staging — Standby NN WARN 방지)
HADOOP_CONF_DIR=/etc/hadoop/conf
# CM core-site 의 nameservice URI (예: hdfs://jshincluster). 비우면 클러스터 conf 만 사용.
# HDFS_DEFAULT_FS=hdfs://YOUR_NAMESERVICE
# SPARK_YARN_STAGING_DIR=hdfs://YOUR_NAMESERVICE/user/spark/.sparkStaging
